.utl.require`:src/players/lib/strategy.q;

.stg.countDict:.crd.perfect;                                                                       / count with the perfect count
.stg.countScale:6.3;                                                                               / a Hi-Lo point is worth about 6.3 perfect count points
.stg.getBet:{.stg.betSpread 10 25 40 60 80};                                                       / bet $10 to $80 by the true count
