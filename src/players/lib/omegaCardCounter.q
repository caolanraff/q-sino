.utl.require`:src/players/lib/strategy.q;

.stg.countDict:.crd.omega;                                                                         / count with Omega II
.stg.countScale:1.6;                                                                               / a Hi-Lo point is worth about 1.6 Omega II points
.stg.getBet:{.stg.betSpread 10 25 40 60 80};                                                       / bet $10 to $80 by the true count
